{
  "$schema": "https://opencode.ai/config.json",

  // ── 모델 2종 ──────────────────────────────────────────────────────────
  //   codemate/CodeLLMPro    무난 — 규칙 대조에 가까운 작업
  //                                 (명명 규칙 대조, JSON 변환)
  //   codemate/CodeLLMMax    고가 — 틀리면 비싼 작업
  //                                 (오케스트레이션, 대상 단위 확정, 미참조 판정,
  //                                  구조 재설계, SQL, 제안 검증)
  //
  // 08 과 같은 입장입니다 — 이 하네스도 **저렴 등급을 쓰지 않습니다.**
  // 실제 코드베이스를 보고 팀 회의 자료를 만드는 용도라, 틀린 제안의 비용이
  // 모델 비용보다 훨씬 큽니다.
  //
  // Max 를 준 여섯 자리의 이유:
  //   code-scoper     대상 단위(U1, U2 …)를 여기서 확정합니다.
  //                   틀리면 뒤의 네 리뷰어가 전부 틀린 것을 봅니다.
  //   refac-hygiene   "이 코드는 아무도 안 쓴다"를 말하는 자리입니다.
  //                   WPF 는 참조가 XAML·문자열·리플렉션으로 새기 때문에,
  //                   이 판정의 오탐 비용이 이 하네스에서 가장 큽니다.
  //   refac-design    구조를 바꾸자고 말하는 자리. 추론이 가장 깊습니다.
  //   refac-sql       운영 DB 로 나가는 쿼리. 잘못 통과시키는 비용이 큽니다.
  //   refac-verifier  오탐을 놓치면 회의 시간이 통째로 날아갑니다.
  //   refactor-lead   게이트 판단과 개선 로드맵을 직접 씁니다.
  //                   primary 라 대화 턴마다 도는 자리입니다 — 세션 비용이 올라갑니다.
  //
  // 아래 전역값은 이 하네스 밖(사용자 기본 에이전트)에만 적용됩니다.
  // 에이전트 8종은 전부 자기 model: 을 갖고 있습니다.
  "model": "codemate/CodeLLMPro",

  "subagent_depth": 1,

  // 이 하네스는 아무것도 고치지 않습니다. 제안만 합니다.
  // 전역 기본값부터 편집을 닫아 두고, 각 에이전트가 자기 보고서를 쓸 수 있도록
  // "*_workspace/*" 만 개별로 엽니다.
  "permission": {
    "edit": "deny",
    "bash": "ask"
  }
}

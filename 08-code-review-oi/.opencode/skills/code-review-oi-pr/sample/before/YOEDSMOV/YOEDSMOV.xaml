<UserControl x:Class="YOEDSMOV.YOEDSMOV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dpi="clr-namespace:DPImgr.Controls;assembly=DPImgr.Controls"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <!-- 조회 조건 줄의 공통 여백 -->
        <Thickness x:Key="FieldMargin">0,0,8,0</Thickness>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 조회 조건 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
            <TextBlock Text="Lot ID" VerticalAlignment="Center"
                       Margin="{StaticResource FieldMargin}" />
            <TextBox x:Name="txtLotId" Width="160"
                     Margin="{StaticResource FieldMargin}" />
            <Button x:Name="btnSearch" Content="조회" Width="80"
                    Click="btnSearch_Click" />
        </StackPanel>

        <dpi:DpiDataGrid x:Name="grdLot" Grid.Row="1" Margin="8,0"
                         AutoGenerateColumns="False"
                         SelectionMode="Extended" />

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="8">
            <Button x:Name="btnConfirm" Content="반출 확정" Width="100"
                    Click="btnConfirm_Click" />
        </StackPanel>

        <Border x:Name="loading" Grid.RowSpan="3" Background="#80000000"
                Visibility="Collapsed">
            <TextBlock Text="조회 중..." Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>

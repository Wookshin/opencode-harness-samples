<UserControl x:Class="YOEDSMOV.YOEDSMOV"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dpi="clr-namespace:DPImgr.Controls;assembly=DPImgr.Controls"
             Loaded="OnLoaded">

    <UserControl.Resources>
        <!-- 조회 조건 줄의 공통 여백 -->
        <Thickness x:Key="FieldMargin">0,0,8,0</Thickness>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 조회 조건 -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="8">
            <TextBlock Text="Lot ID" VerticalAlignment="Center"
                       Margin="{StaticResource FieldMargin}" />
            <TextBox x:Name="txtLotId" Width="160"
                     Margin="{StaticResource FieldMargin}" />
            <Button x:Name="btnSearch" Content="조회" Width="80"
                    Click="btnSearch_Click" />
        </StackPanel>

        <dpi:DpiDataGrid x:Name="grdLot" Grid.Row="1" Margin="8,0"
                         AutoGenerateColumns="False"
                         SelectionMode="Extended">
            <!-- 컬럼이 코드에만 있어 화면에서 안 보인다는 말이 있어 XAML 로도 적었습니다 -->
            <dpi:DpiDataGrid.Columns>
                <DataGridTextColumn Header="Lot ID"   Width="140"
                                    Binding="{Binding LOT_ID}" />
                <DataGridTextColumn Header="Material" Width="140"
                                    Binding="{Binding MAT_ID}" />
                <DataGridTextColumn Header="수량"     Width="80"
                                    Binding="{Binding LOT_QTY}" />
                <DataGridTextColumn Header="상태"     Width="90"
                                    Binding="{Binding LOT_STATUS, Mode=OneWay}" />
            </dpi:DpiDataGrid.Columns>
        </dpi:DpiDataGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="8">
            <TextBlock VerticalAlignment="Center"
                       Margin="{StaticResource FieldMargin}"
                       Text="{Binding SelectedItems.Count, ElementName=grdLot, StringFormat=선택 {0}건}" />
            <Button x:Name="btnConfirm" Content="반출 확정" Width="100"
                    Click="btnConfirm_Click" />
        </StackPanel>

        <Border x:Name="loading" Grid.RowSpan="3" Background="#80000000"
                Visibility="Collapsed">
            <TextBlock Text="조회 중..." Foreground="White"
                       HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
    </Grid>
</UserControl>

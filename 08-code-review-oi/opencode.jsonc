{
  "$schema": "https://opencode.ai/config.json",

  // ── 모델 2종 ──────────────────────────────────────────────────────────
  //   codemate/CodeLLMPro    무난 — 판단이 필요한 작업
  //                                 (오케스트레이션, 명명 규칙, 기능 리뷰, JSON 변환)
  //   codemate/CodeLLMMax    고가 — 틀리면 비싼 작업
  //                                 (변경단위 분류, SQL 리뷰, 지적 검증)
  //
  // 다른 샘플과 달리 이 하네스는 **저렴 등급을 쓰지 않습니다.**
  // 실제 PR 을 보고 팀 회의 자료를 만드는 용도라, 틀린 리포트의 비용이
  // 모델 비용보다 훨씬 큽니다.
  //
  // Max 를 준 세 자리의 이유:
  //   diff-scoper     변경 유형(신규/변경/이름변경)을 여기서 확정합니다.
  //                   틀리면 뒤의 세 리뷰어가 전부 틀린 것을 봅니다.
  //   review-sql      운영 DB 로 나가는 쿼리. 잘못 통과시키는 비용이 가장 큽니다.
  //   review-verifier 오탐을 놓치면 회의 시간이 통째로 날아갑니다.
  "model": "codemate/CodeLLMPro",

  "subagent_depth": 1,

  // 이 하네스는 아무것도 고치지 않습니다. 전역 기본값부터 편집을 닫아 둡니다.
  // 각 에이전트가 자기 보고서를 쓸 수 있도록 "*_workspace/*" 만 개별로 엽니다.
  "permission": {
    "edit": "deny",
    "bash": "ask"
  }
}
